rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared by reviews/{reviewId}/replies below -- same visibility a
    // review itself has (its own read rule, duplicated here since a
    // subcollection's rules can't reference a sibling match block).
    function reviewVisible(reviewId) {
      let review = get(/databases/$(database)/documents/reviews/$(reviewId));
      return (exists(/databases/$(database)/documents/users/$(review.data.userId))
          && get(/databases/$(database)/documents/users/$(review.data.userId)).data.get('public', false) == true)
        || (request.auth != null
            && (reviewId.split('_')[0] == request.auth.uid
                || exists(/databases/$(database)/documents/friend_edges/$(request.auth.uid + '_' + review.data.userId))));
    }

    // --- Existing production rules, kept as-is (stricter than the new
    // defaults below): public read, ownership-validated writes, immutable
    // checkins, and leaderboard entries locked to their own owner. ---
    match /checkins/{checkinId} {
      allow read: if true;
      allow create: if request.auth != null
        && checkinId == request.auth.uid + '_' + request.resource.data.landmarkId
        && request.resource.data.userId == request.auth.uid;
      // Owner may update ONLY photoURL / photoURLs / userName (own check-in
      // photos via addCheckinPhoto/removeCheckinPhoto, the legacy single
      // attachCheckinPhoto, email->username backfill via backfillUserName).
      // Points, landmarkId, userId, etc. stay immutable so scores can't be
      // tampered with.
      allow update: if request.auth != null
        && checkinId.split('_')[0] == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'photoURLs', 'userName']);
      allow delete: if false;
    }
    match /leaderboard_entries/{entryId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // The client re-writes its own username doc on save even when it
      // already exists (e.g. re-submitting the same name, or touching other
      // fields) -- that's an update in Firestore's terms since the doc
      // already exists, which was never granted before.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /friend_requests/{id} {
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.resource.data.from))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.from + '_' + request.resource.data.to));
    }

    // id is always the referred user's own uid -- at most one referral doc
    // per account, so nobody can rack up bonuses "signing up" repeatedly.
    // Each side (referrer, referred) can only ever flip its own uid's claim
    // flag, and only once each field is created false -- see item i8.
    match /referrals/{id} {
      allow get: if request.auth != null && (id == request.auth.uid || resource.data.referrerUid == request.auth.uid);
      allow list: if request.auth != null && resource.data.referrerUid == request.auth.uid;
      allow create: if request.auth != null
        && id == request.auth.uid
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.referredClaimed == false
        && request.resource.data.referrerClaimed == false;
      allow update: if request.auth != null
        && (
          (id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referredClaimed'])
            && request.resource.data.referredClaimed == true)
          || (resource.data.referrerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referrerClaimed'])
              && request.resource.data.referrerClaimed == true)
        );
      allow delete: if false;
    }

    // id is always "{blockerUid}_{blockedUid}". Read/list/delete are scoped
    // to your own outgoing blocks; other rules below use exists() on a
    // specific id to check a block regardless of these rules (exists()/get()
    // bypass the target collection's own rules, same as the users/public
    // check on reviews further down).
    match /blocks/{id} {
      allow get: if request.auth != null && id.split('_')[0] == request.auth.uid;
      allow list: if request.auth != null && resource.data.blockerUid == request.auth.uid;
      allow create: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if request.auth != null && id.split('_')[0] == request.auth.uid;
    }
    match /friend_edges/{id} {
      // get: id is always "{ownerUid}_{friendUid}" (the client checks for an
      // edge's existence before it exists, to decide whether to send a
      // friend request) -- checking resource.data.owner crashes with
      // "permission denied" instead of a clean not-found when the doc
      // doesn't exist yet, since resource is null. Checking the id itself
      // works either way.
      allow get: if request.auth != null && id.split('_')[0] == request.auth.uid;
      // list: the client also queries where('owner','==',uid) to load "my
      // friends" -- Firestore can only verify a list query against a rule
      // that mirrors the query's own field filter, not an id-based check, so
      // this needs the resource.data version specifically (using the id
      // version here silently rejects the whole query instead).
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && (request.resource.data.owner == request.auth.uid || request.resource.data.friend == request.auth.uid);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /reviews/{reviewId} {
      // A review (comment, stars, photos) is visible to: its own author, a
      // friend of the author, or anyone at all if the author's account is
      // public (users/{uid}.public == true, set via the Profile page's
      // Privacy toggle -- default is private/friends-only). This is
      // evaluated per-document, so a list query (e.g. a landmark's Visitor
      // Reviews) silently drops any review this viewer isn't allowed to see
      // -- the client no longer needs its own separate photo-visibility
      // check. exists() is checked before get() so a reviewer who somehow
      // has no users/{uid} doc yet fails safe (denied) instead of erroring.
      // Hidden once REPORT_HIDE_THRESHOLD (2) distinct people have reported
      // it -- unless you're the author or an admin -- and hidden from
      // either side of a block, on top of the existing visibility check.
      //
      // resource == null first: submitReview's transaction always reads this
      // doc before writing it (to know whether it's a new rating or an edit),
      // and for a landmark's first-ever rating the doc doesn't exist yet --
      // resource is null then, so resource.data.userId below would otherwise
      // throw inside the rule itself. Firestore treats a thrown rule as a
      // hard deny, not the clean "not found" a missing doc should be, which
      // made every first-time rating fail with permission-denied.
      allow read: if
        resource == null
        || (
          (exists(/databases/$(database)/documents/users/$(resource.data.userId))
            && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('public', false) == true)
          || (request.auth != null
              && (reviewId.split('_')[0] == request.auth.uid
                  || exists(/databases/$(database)/documents/friend_edges/$(request.auth.uid + '_' + resource.data.userId))))
        )
        && (
          resource.data.get('reportedBy', []).size() < 2
          || (request.auth != null
              && (reviewId.split('_')[0] == request.auth.uid || request.auth.token.email in ['landymontiel25@gmail.com']))
        )
        && !(request.auth != null
          && (exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + resource.data.userId))
              || exists(/databases/$(database)/documents/blocks/$(resource.data.userId + '_' + request.auth.uid))));
      allow create: if request.auth != null
        && reviewId == request.auth.uid + '_' + request.resource.data.landmarkId
        && exists(/databases/$(database)/documents/checkins/$(reviewId));
      // Two ways to update: the author editing their own review (unchanged),
      // or someone else reporting it -- which may ONLY append their own uid
      // to reportedBy, exactly once, touching no other field. That, plus
      // "each uid appears at most once," is what makes the read rule above
      // an actual server-side enforcement instead of a client-side filter.
      allow update: if request.auth != null
        && (
          (reviewId == request.auth.uid + '_' + request.resource.data.landmarkId
            && exists(/databases/$(database)/documents/checkins/$(reviewId)))
          || (
            reviewId.split('_')[0] != request.auth.uid
            && !(resource.data.get('reportedBy', []).hasAny([request.auth.uid]))
            && request.resource.data.reportedBy == resource.data.get('reportedBy', []).concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          )
        );
      allow delete: if request.auth != null && reviewId.split('_')[0] == request.auth.uid;
    }
    match /reviews/{reviewId}/replies/{replyId} {
      // Same visibility as the review itself -- a reply thread on a
      // friends-only or private review shouldn't be more exposed than the
      // review it's attached to.
      allow read: if reviewVisible(reviewId);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      // The reply's own author, the review's author (moderating their own
      // thread), or an admin can remove a reply. No editing in v1.
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || reviewId.split('_')[0] == request.auth.uid
            || request.auth.token.email in ['landymontiel25@gmail.com']);
    }
    // ✓ / ✗ on a Mapr pick ("I'd go" / "not for me"). Private to its
    // owner; one doc per user+landmark, so the id is pinned to both.
    match /pick_feedback/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.landmarkId
        && request.resource.data.verdict in ['yes', 'no'];
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /landmark_ratings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landmark_overrides/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /custom_landmarks/{id} {
      // Same reportedBy hide-past-threshold rule as reviews, unless you're
      // the submitter or an admin.
      allow read: if resource.data.get('reportedBy', []).size() < 2
        || (request.auth != null
            && (resource.data.createdBy == request.auth.uid || request.auth.token.email in ['landymontiel25@gmail.com']));
      // A brand-new submission always starts "pending" -- enforced here, not
      // just in the app's own code, so calling the database directly can't
      // skip the approval queue and self-publish as "approved".
      allow create: if request.auth != null && request.resource.data.status == 'pending';
      // An admin can change status (approve) or anything else. Anyone else
      // (not the submitter) may only report it -- same restricted
      // reportedBy-append as reviews above.
      allow update: if request.auth != null
        && (
          request.auth.token.email in ['landymontiel25@gmail.com']
          || (
            resource.data.createdBy != request.auth.uid
            && !(resource.data.get('reportedBy', []).hasAny([request.auth.uid]))
            && request.resource.data.reportedBy == resource.data.get('reportedBy', []).concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          )
        );
      // Only the original submitter or an admin can delete a submission --
      // any other signed-in account could wipe any landmark before this.
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || request.auth.token.email in ['landymontiel25@gmail.com']);
    }

    // Profile's "Request a Feature" -- anyone signed in can submit one
    // (always starting "pending", same enforced-not-just-client-side
    // pattern as custom_landmarks above); only the submitter or an admin
    // can read it back, and only an admin can flip its status via the
    // Approve/Reject Features tab.
    match /feature_requests/{id} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || request.auth.token.email in ['landymontiel25@gmail.com']);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && request.auth.token.email in ['landymontiel25@gmail.com'];
      allow delete: if request.auth != null && request.auth.token.email in ['landymontiel25@gmail.com'];
    }

    // A trip a few friends build together (item i6). Only current members
    // can see or touch it at all; only the owner can change who's a member
    // (add/remove), while any member can edit the shared landmark list --
    // two separate permissions enforced by which fields a write touches.
    match /group_trips/{tripId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow list: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landmarkIds'])
          || (request.auth.uid == resource.data.ownerUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames', 'name'])
              && request.resource.data.ownerUid in request.resource.data.memberUids)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // In-app notifications (item i2's non-push slice -- see the lib file for
    // why this project can't wire up real push yet). Only the owning uid can
    // ever read them; an admin can also create one for someone else (e.g.
    // "your submission was approved"). A regular account can additionally
    // notify a fellow member of a real group_trips doc (e.g. "you were
    // added to a group trip") -- both the writer and the notified uid must
    // already be members of that same trip, which by write order (member
    // added first, notification second) is only ever true right after a
    // real invite. A regular account can also notify the admin specifically
    // (never anyone else) about a new "Request a Feature" submission --
    // resolved by the target uid's OWN users/{uid}.email rather than a
    // hardcoded uid, so this doesn't need updating if the admin account
    // ever changes. Nothing lets one regular account write into another's
    // notifications outside those two cases.
    match /notifications/{id} {
      allow get, list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid
            || request.auth.token.email in ['landymontiel25@gmail.com']
            || (request.resource.data.type == 'group_invite'
                && exists(/databases/$(database)/documents/group_trips/$(request.resource.data.groupTripId))
                && request.auth.uid in
                   get(/databases/$(database)/documents/group_trips/$(request.resource.data.groupTripId)).data.memberUids
                && request.resource.data.uid in
                   get(/databases/$(database)/documents/group_trips/$(request.resource.data.groupTripId)).data.memberUids)
            || (request.resource.data.type == 'feature_request'
                && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
                && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('email', '')
                   in ['landymontiel25@gmail.com']));
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
