rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /review_photos/{landmarkId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // `write` alone would also have to satisfy request.resource.size /
      // contentType on a delete, where request.resource is null -- meaning
      // no delete could ever succeed. Split out so deletes (used by account
      // deletion, item b3) actually work.
      allow delete: if request.auth != null;
    }
    match /checkin_photos/{landmarkId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // `write` alone would also have to satisfy request.resource.size /
      // contentType on a delete, where request.resource is null -- meaning
      // no delete could ever succeed. Split out so deletes (used by account
      // deletion, item b3) actually work.
      allow delete: if request.auth != null;
    }
    match /landmark_photos/{landmarkId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // `write` alone would also have to satisfy request.resource.size /
      // contentType on a delete, where request.resource is null -- meaning
      // no delete could ever succeed. Split out so deletes (used by account
      // deletion, item b3) actually work.
      allow delete: if request.auth != null;
    }
  }
}
